# Runtime: Supabase transaction pooler (port 6543).
DATABASE_URL=
# Migration commands only: Supabase session pooler (port 5432).
DIRECT_URL=

# DeepSeek report generation (server-side only).
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
# Required on Netlify; use a separate long random value.
REPORT_JOB_SECRET=

# Public HTTPS site origin used in report email links.
PUBLIC_SITE_URL=

# Configure either SMTP or Resend for transactional mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=
